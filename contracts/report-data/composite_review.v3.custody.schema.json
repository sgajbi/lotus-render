{
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "composite_review.v3"
    },
    "qualification": {
      "const": "EXPLICIT_RETAINED_CALCULATED_REPLAY"
    },
    "publication_state": {
      "const": "NOT_ATTESTED"
    },
    "selection": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "source_request": {
          "$ref": "#/$defs/LinkedAnalysisRequest"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/CompositeWindowPin"
          },
          "maxItems": 120,
          "minItems": 1,
          "title": "Windows",
          "type": "array"
        },
        "engine_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Engine Version",
          "type": "string"
        },
        "calculation_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Calculation Fingerprint",
          "type": "string"
        },
        "response_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Response Digest",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "source_request",
        "windows",
        "engine_version",
        "calculation_fingerprint",
        "response_digest"
      ],
      "title": "LinkedAnalysisSelection",
      "type": "object"
    },
    "series_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_revision_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "factual_content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "contract_version",
    "qualification",
    "publication_state",
    "selection",
    "series_digest",
    "source_revision_digest",
    "factual_content_digest"
  ],
  "additionalProperties": false,
  "$defs": {
    "CompositeWindowPin": {
      "additionalProperties": false,
      "properties": {
        "materialization_id": {
          "format": "uuid",
          "title": "Materialization Id",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "restatement_sequence": {
          "minimum": 1,
          "title": "Restatement Sequence",
          "type": "integer"
        },
        "definition_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Definition Content Hash",
          "type": "string"
        },
        "membership_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Membership Content Hash",
          "type": "string"
        },
        "attestation_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Attestation Content Hash",
          "type": "string"
        },
        "source_cut_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Source Cut Id",
          "type": "string"
        },
        "method_binding": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Method Binding",
          "type": "object"
        },
        "retained_receipt_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Retained Receipt Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "materialization_id",
        "period_start",
        "period_end",
        "restatement_sequence",
        "definition_content_hash",
        "membership_content_hash",
        "attestation_content_hash",
        "source_cut_id",
        "method_binding",
        "retained_receipt_fingerprint"
      ],
      "title": "CompositeWindowPin",
      "type": "object"
    },
    "LinkedAnalysisRequest": {
      "additionalProperties": false,
      "description": "Exact registered Performance operation; no client-supplied economics.",
      "properties": {
        "metric_id": {
          "const": "LINKED_MEMBER_CONTRIBUTION",
          "title": "Metric Id",
          "type": "string"
        },
        "method": {
          "const": "CARINO:v1",
          "title": "Method",
          "type": "string"
        },
        "composite_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Composite Id",
          "type": "string"
        },
        "calculation_id": {
          "format": "uuid",
          "title": "Calculation Id",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "return_view": {
          "enum": [
            "GROSS",
            "NET_ACTUAL",
            "NET_MODEL_FEE"
          ],
          "title": "Return View",
          "type": "string"
        },
        "reporting_currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Reporting Currency",
          "type": "string"
        },
        "materialization_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 120,
          "minItems": 1,
          "title": "Materialization Ids",
          "type": "array"
        },
        "restatement_sequence": {
          "default": null,
          "description": "Exact vector selection forbids a competing numeric sequence.",
          "title": "Restatement Sequence",
          "type": "null"
        }
      },
      "required": [
        "metric_id",
        "method",
        "composite_id",
        "calculation_id",
        "period_start",
        "period_end",
        "return_view",
        "reporting_currency",
        "materialization_ids"
      ],
      "title": "LinkedAnalysisRequest",
      "type": "object"
    }
  }
}
